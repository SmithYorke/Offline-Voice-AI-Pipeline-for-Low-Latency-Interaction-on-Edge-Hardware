{
  "asr_command": ["third_party/whisper.cpp/build/bin/whisper-cli"],
  "asr_model": "models/ggml-base.en-q4_0.bin",
  "language": "en",
  "llm_command": ["third_party/llama.cpp/build/bin/llama-completion"],
  "llm_model": "models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf",
  "tts_command": ["python3", "-m", "piper"],
  "tts_model": "models/en_US-lessac-medium.onnx",
  "player_command": ["aplay"],
  "threads": 4,
  "context_size": 1024,
  "max_tokens": 96,
  "temperature": 0.3,
  "timeout_seconds": 180,
  "system_prompt": "You are NOVA, a helpful voice assistant. Reply in English in one or two short sentences.",
  "output_dir": "runs",
  "alsa_device": "default",
  "vad": {
    "threshold": 0.015,
    "frame_ms": 30,
    "silence_ms": 800,
    "preroll_ms": 300,
    "min_speech_ms": 150,
    "max_utterance_seconds": 20,
    "wait_seconds": 30
  }
}
